  },
  "autoInheritDesc": {
    "message": "ሲነቃ፣ ከተነጠለ መገለጫ በአገናኝ (አዲስ ትር አገናኞች፣ Ctrl-ጠቅታ፣ መካከለኛ-ጠቅታ) የተከፈቱ ትሮች የChrome ነባሪ ኩኪዎችን ከመጠቀም ይልቅ በዚያ መገለጫ ውስጥ ይቆያሉ።"
  },
  "groupTabsByProfileLabel": {
    "message": "ትሮችን በትር አሞሌ ውስጥ በመገለጫ ቡድን ማድረግ"
  },
  "groupTabsByProfileDesc": {
    "message": "እያንዳንዱን መገለጫ ትሮች ባለቀለም የትር ቡድን ውስጥ ያስገባል። Chrome የትር ቡድኖችን ለማስተዳደር ፈቃድ ይጠይቃል። ይህ ትሮችዎን እንደገና ያደራጃል፣ የቡድን ቀለሞችም በChrome 9 አስቀድሞ በተዘጋጁ ቀለሞች የተገደቡ ናቸው፣ ስለዚህ ሁለት የመገለጫ ቀለሞች ተመሳሳይ ሊመስሉ ይችላሉ።"
  },
  "groupTabsPermissionDeniedNotice": {
    "message": "ፈቃድ ተከልክሏል። የትር ቡድን ማድረግ ጠፍቶ ይቆያል።"
  },
  "aboutTagline": {
    "message": "ለትር-በትር ክፍለ ጊዜ መነጠል የተዘጋጀ ነጻ፣ ክፍት-ምንጭ የChrome ቅጥያ። በተመሳሳይ ድረ-ገጽ ላይ በበርካታ መለያዎች በአንድ ጊዜ ገብተው ይቆዩ።"
  },
